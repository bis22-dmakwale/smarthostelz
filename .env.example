DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
BANK_SIMULATOR_TOKEN=replace-with-a-long-random-token
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_GENDER=male
SEED_STUDENT_PROGRAMME_YEARS=4
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Public base URL used in email links and PayChangu callbacks (use your ngrok/Vercel URL when testing webhooks)
APP_URL=https://smarthostelz.vercel.app

# --- Email (Nodemailer). Gmail simulation: enable 2-Step Verification, then create an App Password
#     at https://myaccount.google.com/apppasswords and paste it below (spaces are ignored).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM="MUBAS Smart Hostels <yourname@gmail.com>"
# Who receives admin notifications (comma separated). Leave empty to email every admin account.
ADMIN_NOTIFY_EMAIL=

# --- PayChangu (use the TEST secret key from the PayChangu dashboard while prototyping) ---
PAYCHANGU_SECRET_KEY=
# Optional: webhook secret from the PayChangu dashboard (verifies the "Signature" header)
PAYCHANGU_WEBHOOK_SECRET=
 